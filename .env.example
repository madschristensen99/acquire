PRIVATE_KEY=your_private_key_here

# Network Configuration
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# VAPID Keys for Push Notifications (generate with: npm run generate-vapid)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your-email@example.com

# Contract Configuration for Notification Server
CONTRACT_ADDRESS=your_deployed_contract_address
RPC_URL=https://sepolia.base.org

# Notification Server Port
NOTIFICATION_PORT=3001

# Block Explorer API Keys (for contract verification)
# Get Arbiscan API key from: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=your_arbiscan_api_key_here
# Get Basescan API key from: https://basescan.org/myapikey  
BASESCAN_API_KEY=your_basescan_api_key_here
# Get Etherscan API key from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Faucet Configuration (for auto-funding user wallets)
# Private key of wallet that will fund users with testnet ETH
FAUCET_PRIVATE_KEY=your_faucet_wallet_private_key_here
# Arbitrum Sepolia RPC URL for faucet transactions
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Database connection string (MongoDB)
DATABASE_URL=